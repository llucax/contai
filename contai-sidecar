#!/bin/sh
set -eu

# Manages contai's sidecars: separate containers holding something the AI
# container must not hold itself, and reachable from it through one narrow
# channel only.
#
# Every service below defines four things: a container name, a start hook that
# refuses when the service is not configured, a prime hook run after every
# "up", and an opts hook printing the docker run options the AI container
# needs to reach it. Adding a sidecar means adding a block and a name to
# $services.

self=$(basename "$0")

# In start order. Naming a service on the command line picks a subset.
services='github-mcp gpg'

warn() {
	printf '%s: %s\n' "$self" "$1" >&2
}

# --- github-mcp: the GitHub API behind a PAT the AI container never sees ---

github_mcp_net=contai-net
github_mcp_container=contai-github-mcp
github_mcp_image=contai-github-mcp:latest

# How to retrieve the PAT from the Secret Service (libsecret/KeePassXC).
# Override by exporting CONTAI_MCP_PAT_CMD. Set to `false` to disable lookups.
: "${CONTAI_MCP_PAT_CMD:=secret-tool lookup service github-mcp}"
: "${CONTAI_MCP_TOOLSETS:=all}"

github_mcp_start() {
	# Enable knob: a retrievable PAT means "on".
	if ! pat=$(eval "$CONTAI_MCP_PAT_CMD" 2>/dev/null) || test -z "$pat"
	then
		warn "no PAT found; github-mcp disabled"
		return 1
	fi

	docker network inspect "$github_mcp_net" >/dev/null 2>&1 ||
		docker network create "$github_mcp_net" >/dev/null
	docker rm -f "$github_mcp_container" >/dev/null 2>&1 || true

	export GITHUB_PERSONAL_ACCESS_TOKEN="$pat"

	# Build args safely (POSIX, shellcheck-clean).
	set -- -d --name "$github_mcp_container" \
		--network "$github_mcp_net" --restart unless-stopped \
		--cap-drop=ALL --security-opt=no-new-privileges \
		--read-only --tmpfs /tmp:rw,nosuid,nodev,size=64m \
		--pids-limit 256 --memory 512m \
		-e GITHUB_PERSONAL_ACCESS_TOKEN \
		-e GITHUB_TOOLSETS="$CONTAI_MCP_TOOLSETS"
	if test -n "${CONTAI_MCP_READONLY:-}"
	then
		set -- "$@" -e GITHUB_READ_ONLY=1
	fi
	set -- "$@" "$github_mcp_image"

	docker run "$@" >/dev/null
	unset GITHUB_PERSONAL_ACCESS_TOKEN pat
}

github_mcp_opts() {
	echo "--network=$github_mcp_net"
}

# --- gpg: the signing key, reachable only as "sign this" ------------------

gpg_container=contai-gpg
gpg_image=contai-gpg:latest
gpg_volume=contai-gpg-sock

# The restricted socket, as the sidecar and the AI container respectively see
# it. The docker volume above is all they share.
gpg_sidecar_socket_dir=/run/contai-gpg
gpg_sidecar_socket=$gpg_sidecar_socket_dir/S.gpg-agent
gpg_client_socket_dir=/run/contai/gpg

# How many seconds to give the agent to answer after the container is created.
gpg_start_timeout=10

# The secret keys, mounted into the gpg sidecar and into nothing else. The AI
# container keeps only the public half of the key in its own home.
gpg_home=~/.local/share/contai/gpg

# How to retrieve the passphrase of the signing key from the Secret Service.
: "${CONTAI_GPG_SECRET_CMD:=secret-tool lookup cli-id contai-gpg-secret}"
# For how long gpg-agent holds on to a preset passphrase, in seconds.
: "${CONTAI_GPG_CACHE_TTL:=604800}"

gpg_start() {
	# Enable knob: a key in the store means "on".
	if ! gpg_has_secret_keys
	then
		warn "no secret keys in $gpg_home; gpg disabled"
		return 1
	fi

	docker rm -f "$gpg_container" >/dev/null 2>&1 || true

	# No network at all: the agent talks to nothing but the two sockets. The
	# key store is the only bind mount, and the AI container never gets it.
	if ! docker run -d --name "$gpg_container" \
		--network none --restart unless-stopped \
		--cap-drop=ALL --security-opt=no-new-privileges \
		--pids-limit 64 --memory 256m \
		-e CONTAI_GPG_CACHE_TTL="$CONTAI_GPG_CACHE_TTL" \
		-e CONTAI_GPG_EXTRA_SOCKET="$gpg_sidecar_socket" \
		-v "$gpg_home:/gnupg" \
		-v "$gpg_volume:$gpg_sidecar_socket_dir" \
		"$gpg_image" >/dev/null
	then
		warn "could not start $gpg_container"
		return 1
	fi

	if ! gpg_wait_for_agent
	then
		warn "$gpg_container is up but its agent never answered"
		warn "see what it says: docker logs $gpg_container"
		return 1
	fi
}

gpg_has_secret_keys() {
	test -d "$gpg_home/private-keys-v1.d" || return 1
	set -- "$gpg_home"/private-keys-v1.d/*.key
	test -e "$1"
}

# `docker run -d` returns once the container exists, which is a moment before
# gpg-agent has bound its sockets, so priming right away would be talking to
# something that is not listening yet. Wait for an answer on the very socket
# the AI container will use, which doubles as the first proof that the whole
# path works.
gpg_wait_for_agent() {
	waited=0

	while ! docker exec "$gpg_container" gpg-connect-agent \
		--no-autostart -S "$gpg_sidecar_socket" /bye >/dev/null 2>&1
	do
		if test "$waited" -ge "$gpg_start_timeout"
		then
			return 1
		fi

		sleep 1
		waited=$((waited + 1))
	done
}

# Fill gpg-agent's passphrase cache, so that signing in the AI container needs
# no pinentry it could not answer anyway. This runs on every "up", the already
# running case included, so a cache that expired under a long-lived container
# gets filled again.
#
# The passphrase travels through the pipe into `docker exec` and nowhere else:
# not through a file, an environment variable or an argument, each of which
# every other process of this user could read. The lookup is skipped entirely
# while the cache is still warm, so a keyring that asks before handing the
# secret over asks once per cache lifetime rather than once per contai run.
gpg_prime() {
	if docker exec "$gpg_container" contai-gpg-preset --check >/dev/null
	then
		return 0
	fi

	if ! secret=$(eval "$CONTAI_GPG_SECRET_CMD" 2>/dev/null) ||
		test -z "$secret"
	then
		warn "no passphrase found; the gpg sidecar cannot sign"
		return 1
	fi

	if ! printf '%s' "$secret" |
		docker exec -i "$gpg_container" contai-gpg-preset
	then
		warn "could not preset the passphrase in the gpg sidecar"
		return 1
	fi

	unset secret
}

gpg_opts() {
	# Read-only: connecting to a socket needs no write permission on the
	# mount, and there is nothing else in there to write to anyway.
	echo "--volume=$gpg_volume:$gpg_client_socket_dir:ro"
}

# --- the generic part -----------------------------------------------------

# Points the svc_* variables at the hooks of one service. Every action below
# calls this first, so an unknown name is caught in one place.
select_service() {
	svc_prime=:
	svc_opts=:

	case $1 in
	github-mcp)
		svc_container=$github_mcp_container
		svc_start=github_mcp_start
		svc_opts=github_mcp_opts
		;;
	gpg)
		svc_container=$gpg_container
		svc_start=gpg_start
		svc_prime=gpg_prime
		svc_opts=gpg_opts
		;;
	*)
		warn "unknown sidecar: $1"
		return 1
		;;
	esac
}

is_running() {
	test -n "$(docker ps -q -f "name=^/$svc_container$" -f status=running)"
}

up_one() {
	select_service "$1"

	if is_running || "$svc_start"
	then
		"$svc_prime" || warn "$1: priming failed"
	fi

	# Whatever went wrong with one sidecar, the next one and the contai run
	# itself are still worth attempting.
	return 0
}

down_one() {
	select_service "$1"
	docker rm -f "$svc_container" >/dev/null 2>&1 || true
}

opts_one() {
	select_service "$1"

	if is_running
	then
		"$svc_opts"
	fi
}

usage() {
	cat >&2 <<-EOF
		usage: $self [up|down|status] [<service>...]
		       $self opts [<service>...]

		Services: $services. All of them when none is named.

		up      start the sidecars that are configured, and prime them
		down    remove the sidecar containers
		status  list the sidecar containers
		opts    print the docker run options the AI container needs to
		        reach the running sidecars, one argument per line
	EOF
	exit 2
}

cmd=${1:-up}

if test $# -gt 0
then
	shift
fi

targets=$*

if test -z "$targets"
then
	targets=$services
fi

# Service names hold no whitespace, so the unquoted expansions below split
# exactly where they should. Checking every name up front keeps a typo from
# acting on half the sidecars before failing.
# shellcheck disable=SC2086
for name in $targets
do
	select_service "$name" || exit 2
done

case $cmd in
up)
	# shellcheck disable=SC2086
	for name in $targets
	do
		up_one "$name"
	done
	;;
down)
	# shellcheck disable=SC2086
	for name in $targets
	do
		down_one "$name"
	done
	;;
opts)
	# shellcheck disable=SC2086
	for name in $targets
	do
		opts_one "$name"
	done
	;;
status)
	# Repeated name filters are OR'ed by docker, so one listing covers them.
	set -- ps
	# shellcheck disable=SC2086
	for name in $targets
	do
		select_service "$name"
		set -- "$@" -f "name=^/$svc_container$"
	done
	docker "$@"
	;;
*)
	usage
	;;
esac
