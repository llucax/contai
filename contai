#!/usr/bin/env bash
set -eu

tool=$(basename "$0")

if test "$tool" = "contai"
then
	tool=
fi

data_dir=~/.local/share/contai

home_dir=$data_dir/home
# Where the persistent home is mounted, which is also $HOME in the container:
# the image is built with the host's home directory as the account's home, so
# an absolute path below it means the same thing on both sides.
container_home=$HOME
env_file="$data_dir/env.list"
run_opts_file="$data_dir/docker-run-opts.list"

mkdir -p "$home_dir"
touch "$env_file" "$run_opts_file"

# Follow $run_opts_file through any symbolic links, to learn where it really
# lives. Config managers such as GNU Stow leave it as a link into a dotfiles
# directory, which may well be the directory being mounted below.
opts_path=$run_opts_file
hops=0

while test -L "$opts_path"
do
	hops=$((hops + 1))
	if test "$hops" -gt 40
	then
		echo "contai: too many symbolic links to follow from $run_opts_file" >&2
		exit 1
	fi
	target=$(readlink "$opts_path")
	case $target in
	/*) opts_path=$target ;;
	*) opts_path=$(dirname "$opts_path")/$target ;;
	esac
done

# The current directory is mounted writable further down. If it holds either
# the options file or the directory the link to it lives in, whatever runs in
# the container can choose the docker options of the *next* run, which is a
# way out of the sandbox. Refuse instead of quietly handing that over.
#
# Everything is resolved physically first. $PWD keeps the symbolic links that
# were followed to reach the directory, while docker resolves them when it
# mounts it, so comparing $PWD as it stands would let a symlinked path whose
# target holds these through.
#
# The prefix is assigned rather than inlined in the pattern: written as
# "${pwd_real%/}"/* it fails to match when the expansion is empty, which is
# exactly $PWD being /, and the check would pass.
pwd_real=$(pwd -P)
pwd_prefix=${pwd_real%/}
data_dir_real=$(cd "$data_dir" && pwd -P)
opts_dir_real=$(cd "$(dirname "$opts_path")" && pwd -P)

for exposed in "$data_dir_real" "$opts_dir_real"
do
	case $exposed/ in
	"$pwd_prefix"/*)
		echo "contai: refusing to run from $pwd_real" >&2
		echo "contai: it contains $exposed, so whatever runs in the" >&2
		echo "contai: container could rewrite $run_opts_file and pick" >&2
		echo "contai: the options of the next run" >&2
		exit 1
		;;
	esac
done

# One argument per line, taken verbatim: no splitting, so no quoting rules
# and paths may contain spaces. Called with a redirection rather than through
# a pipe, so that it appends to the array of the caller instead of to a copy
# in a subshell.
run_opts=()

read_opts() {
	while IFS= read -r opt || test -n "$opt"
	do
		case $opt in
		'' | \#*)
			continue
			;;
		esac
		run_opts+=("$opt")
	done
}

# Bring up the sidecars, each of which is a no-op unless it is configured, and
# ask what the container needs in order to reach the ones that came up: a
# network to join, a socket volume to mount. Their own diagnostics are hidden,
# as running without a sidecar is the normal case; run `contai-sidecar up` by
# hand to see why one stayed down.
sidecar=$(dirname "$0")/contai-sidecar
"$sidecar" up >/dev/null 2>&1 || true
sidecar_opts=$("$sidecar" opts 2>/dev/null) || sidecar_opts=

read_opts <<EOF
$sidecar_opts
EOF

read_opts < "$run_opts_file"

cmd=(contai:latest /usr/local/bin/contai-bootstrap)

if test -n "$tool"
then
	cmd+=("$tool")
fi

# The options from $run_opts_file come last, so they can override the ones above,
# including the ones doing the sandboxing. That is deliberate, and documented.
# The sidecar options sit just before them, so they can be overridden too.
#
# They go through the ${a[@]+"${a[@]}"} guard because the file is empty for
# anyone who has not put anything in it, and expanding an empty array under
# `set -u` is an error before bash 4.4, which is what macOS ships as
# /bin/bash. $cmd needs no guard, as it always holds the image at least.

docker run \
	--rm \
	-it \
	--user $(id -un):$(id -gn) \
	--cap-drop=ALL \
	--security-opt=no-new-privileges \
	-e TERM="$TERM" -e COLORTERM="$COLORTERM" \
	--env-file "$env_file" \
	-v "$home_dir:$container_home" \
	-v "$PWD:$PWD" \
	-w "$PWD" \
	"${run_opts[@]+"${run_opts[@]}"}" \
	"${cmd[@]}" \
	"$@"
