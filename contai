#!/bin/sh
set -eu

tool=$(basename "$0")

if test "$tool" = "contai"
then
	tool=
fi

data_dir=~/.local/share/contai

home_dir=$data_dir/home
env_file="$data_dir/env.list"

mkdir -p "$home_dir"
touch "$env_file"

# Bring up the github MCP sidecar if a PAT is available (no-op otherwise) and
# join its private network only when it is actually running.
net_opt=
"$(dirname "$0")/contai-mcp" up >/dev/null 2>&1 || true
if test -n "$(docker ps -q -f 'name=^/contai-github-mcp$' -f status=running)"
then
	net_opt=--network=contai-net
fi

docker run \
	--rm \
	-it \
	${net_opt:+"$net_opt"} \
	--user $(id -un):$(id -gn) \
	--cap-drop=ALL \
	--security-opt=no-new-privileges \
	-e TERM="$TERM" -e COLORTERM="$COLORTERM" \
	--env-file "$env_file" \
	-v "$home_dir:$HOME" \
	-v "$PWD:$PWD" \
	-w "$PWD" \
	contai:latest \
	/usr/local/bin/contai-bootstrap \
	$tool \
	"$@"
